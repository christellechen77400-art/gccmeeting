# Copier ce fichier en .env et remplir les valeurs. Ne jamais commiter .env.

# API DeepSeek, compatible Anthropic
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Clé API DeepSeek (https://platform.deepseek.com/api_keys)
ANTHROPIC_API_KEY=

# Modèle : deepseek-flash (par défaut) ou deepseek-v4-pro
ANTHROPIC_MODEL=deepseek-flash

# Clé API Groq pour la transcription audio (https://console.groq.com/keys)
GROQ_API_KEY=
